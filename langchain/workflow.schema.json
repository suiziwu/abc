{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ruoyi.local/langchain/langgraph-workflow.schema.json",
  "title": "LangGraph StateGraph Workflow Manifest",
  "description": "讯飞星火工作流转换后的 LangGraph 语义图清单。extensions.source 完整保留原始 DSL。",
  "type": "object",
  "required": [
    "schema_version",
    "framework",
    "format",
    "flow",
    "state",
    "models",
    "graph",
    "execution",
    "extensions"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "framework": {
      "const": "langchain/langgraph"
    },
    "format": {
      "const": "langgraph-state-graph"
    },
    "flow": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "category",
        "dsl_version",
        "advanced_config_raw"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "category": {"type": "integer"},
        "dsl_version": {"type": "string", "minLength": 1},
        "avatar_icon": {"type": ["string", "null"]},
        "avatar_color": {"type": ["string", "null"]},
        "advanced_config": {"type": ["object", "null"]},
        "advanced_config_raw": {"type": "string"}
      }
    },
    "state": {
      "type": "object",
      "required": ["schema", "defaults"],
      "additionalProperties": true,
      "properties": {
        "schema": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": true,
            "properties": {
              "type": {"type": "string", "enum": ["string", "integer", "number", "boolean", "object", "array"]},
              "default": {},
              "required": {"type": ["boolean", "null"]},
              "producer": {"type": "string"}
            }
          }
        },
        "defaults": {
          "type": "object"
        }
      }
    },
    "models": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": {
        "$ref": "#/definitions/model"
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "entrypoint",
        "finish_point",
        "entrypoint_runtime",
        "finish_runtime",
        "nodes",
        "edges",
        "conditional_edges"
      ],
      "additionalProperties": true,
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "finish_point": {"type": "string", "minLength": 1},
        "entrypoint_runtime": {"type": "string", "minLength": 1},
        "finish_runtime": {"type": "string", "minLength": 1},
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/definitions/node"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/definitions/edge"}
        },
        "conditional_edges": {
          "type": "array",
          "items": {"$ref": "#/definitions/conditional_edge"}
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "entrypoint",
        "finish_point",
        "input_keys",
        "output_template",
        "output_state_keys",
        "output_key",
        "recursion_limit"
      ],
      "additionalProperties": true,
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "finish_point": {"type": "string", "minLength": 1},
        "input_keys": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "output_template": {"type": "string", "minLength": 1},
        "output_state_keys": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "output_key": {"type": "string", "minLength": 1},
        "recursion_limit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "extensions": {
      "type": "object",
      "required": [
        "source_format",
        "source_dsl_version",
        "source_file",
        "source_sha256",
        "converter",
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "source_format": {"const": "iflytek-spark-workflow-dsl"},
        "source_dsl_version": {"type": "string"},
        "source_file": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "converter": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["flowMeta", "flowData"],
          "additionalProperties": true,
          "properties": {
            "flowMeta": {"type": "object"},
            "flowData": {
              "type": "object",
              "required": ["nodes", "edges"],
              "additionalProperties": true,
              "properties": {
                "nodes": {"type": "array"},
                "edges": {"type": "array"}
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "model": {
      "type": "object",
      "required": ["provider", "base_url", "model_name", "temperature", "timeout_seconds"],
      "additionalProperties": true,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "pattern": "^https?://"},
        "model_name": {"type": "string", "minLength": 1},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "api_key_env": {"type": "string"},
        "provider_options": {"type": "object"}
      }
    },
    "port": {
      "type": "object",
      "required": ["id", "name", "type", "schema"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "type": {"type": ["string", "null"]},
        "default": {},
        "required": {"type": ["boolean", "null"]},
        "file_type": {"type": ["string", "null"]},
        "schema": {"type": "object"},
        "from": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": true,
          "properties": {
            "kind": {"type": "string", "enum": ["ref", "literal"]},
            "node_id": {"type": "string"},
            "output": {"type": "string"},
            "output_id": {"type": "string"},
            "value": {}
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "runtime_name",
        "type",
        "iflytek_type",
        "name",
        "inputs",
        "outputs",
        "node_param"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "runtime_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "type": {"type": "string", "enum": ["start", "end", "code", "router", "llm"]},
        "iflytek_type": {"type": "string"},
        "name": {"type": "string"},
        "alias": {"type": ["string", "null"]},
        "node_meta": {"type": "object"},
        "description": {"type": ["string", "null"]},
        "position": {"type": ["object", "null"]},
        "position_absolute": {"type": ["object", "null"]},
        "size": {
          "type": ["object", "null"],
          "properties": {
            "width": {"type": ["number", "null"]},
            "height": {"type": ["number", "null"]}
          }
        },
        "icon": {"type": ["string", "null"]},
        "flags": {"type": "object"},
        "references": {"type": "array"},
        "status": {"type": ["string", "null"]},
        "inputs": {"type": "array", "items": {"$ref": "#/definitions/port"}},
        "outputs": {"type": "array", "items": {"$ref": "#/definitions/port"}},
        "node_param": {"type": "object"},
        "state_writes": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "code"}}, "required": ["type"]},
          "then": {"required": ["code"]}
        },
        {
          "if": {"properties": {"type": {"const": "router"}}, "required": ["type"]},
          "then": {"required": ["router"]}
        },
        {
          "if": {"properties": {"type": {"const": "llm"}}, "required": ["type"]},
          "then": {"required": ["llm"]}
        },
        {
          "if": {"properties": {"type": {"const": "end"}}, "required": ["type"]},
          "then": {"required": ["output"]}
        }
      ]
    },
    "code": {
      "type": "object",
      "required": ["language", "entrypoint", "source", "input_mapping", "state_writes"],
      "additionalProperties": true,
      "properties": {
        "language": {"type": "string", "enum": ["python"]},
        "entrypoint": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "uid": {"type": ["string", "null"]},
        "app_id": {"type": ["string", "null"]},
        "input_mapping": {"type": "object"},
        "state_writes": {"type": "array", "items": {"type": "string"}},
        "operation": {
          "type": ["object", "null"],
          "required": ["type", "input_state_key", "split_index", "outputs"],
          "properties": {
            "type": {"type": "string", "enum": ["split_at"]},
            "input_state_key": {"type": "string", "minLength": 1},
            "split_index": {"type": "integer", "minimum": 0},
            "outputs": {
              "type": "object",
              "required": ["head", "tail"],
              "properties": {
                "head": {"type": "string", "minLength": 1},
                "tail": {"type": "string", "minLength": 1}
              }
            },
            "semantics": {"type": "string"}
          }
        }
      }
    },
    "router": {
      "type": "object",
      "required": ["branches", "default_target"],
      "additionalProperties": true,
      "properties": {
        "uid": {"type": ["string", "null"]},
        "app_id": {"type": ["string", "null"]},
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/branch"}
        },
        "default_target": {"type": "string", "minLength": 1}
      }
    },
    "branch": {
      "type": "object",
      "required": [
        "branch_id",
        "level",
        "logical_operator",
        "conditions",
        "is_default",
        "target",
        "target_runtime"
      ],
      "additionalProperties": true,
      "properties": {
        "branch_id": {"type": "string", "minLength": 1},
        "level": {"type": "integer"},
        "logical_operator": {"type": "string", "enum": ["and", "or"]},
        "conditions": {
          "type": "array",
          "items": {"$ref": "#/definitions/condition"}
        },
        "is_default": {"type": "boolean"},
        "target": {"type": "string", "minLength": 1},
        "target_runtime": {"type": "string", "minLength": 1}
      }
    },
    "condition": {
      "type": "object",
      "required": ["operator", "left", "right"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string"},
        "operator": {"type": "string", "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "contains"]},
        "left": {"type": "object"},
        "right": {"type": "object"}
      }
    },
    "llm": {
      "type": "object",
      "required": ["model", "prompt", "output", "provider"],
      "additionalProperties": true,
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "prompt": {
          "type": "object",
          "required": ["system", "user_template", "input_mapping"],
          "additionalProperties": true,
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "system_template_format": {"type": "string"},
            "user_template": {"type": "string", "minLength": 1},
            "input_mapping": {"type": "object"}
          }
        },
        "output": {
          "type": "object",
          "required": ["name", "state_key"],
          "additionalProperties": true,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "id": {"type": ["string", "null"]},
            "state_key": {"type": "string", "minLength": 1},
            "end_input": {"type": ["string", "null"]}
          }
        },
        "provider": {"type": "object"}
      }
    },
    "end": {
      "type": "object",
      "required": ["template", "input_keys", "state_keys"],
      "additionalProperties": true,
      "properties": {
        "template": {"type": "string", "minLength": 1},
        "stream_output": {"type": ["boolean", "null"]},
        "output_mode": {"type": ["integer", "null"]},
        "input_keys": {"type": "array"},
        "state_keys": {"type": "array", "items": {"type": "string"}}
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "type"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "source_handle": {"type": ["string", "null"]},
        "target_handle": {"type": ["string", "null"]},
        "type": {"type": "string"},
        "edge_type": {"type": ["string", "null"]},
        "marker_end": {"type": ["object", "null"]}
      }
    },
    "conditional_edge": {
      "type": "object",
      "required": ["source", "source_runtime", "branches", "default_target"],
      "additionalProperties": true,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "source_runtime": {"type": "string", "minLength": 1},
        "branches": {"type": "array", "items": {"$ref": "#/definitions/branch"}},
        "default_target": {"type": "string", "minLength": 1}
      }
    }
  }
}
